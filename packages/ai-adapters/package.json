{
  "name": "@yoryi/ai-adapters",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS adapters for Yoryi AI Core",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@yoryi/ai-types": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
