# AI Assistant API Environment Variables

# Server
PORT=4001

# Auth (optional - strict mode disabled by default)
# ASSISTANT_STRICT_AUTH=true
# ASSISTANT_AUTH_JWT_HS_SECRET=your-secret
# ASSISTANT_STRICT_ROLLOUT_PERCENT=100

# BuildingOS Read-Only Query Gateway (for data-backed answers)
BUILDINGOS_READONLY_QUERY_API_BASE_URL=https://your-buildingos-api.example.com
BUILDINGOS_READONLY_QUERY_API_KEY=your-api-key
BUILDINGOS_READONLY_QUERY_TIMEOUT_MS=900

# BuildingOS Financial Gateway (for resident debt queries)
BUILDINGOS_FINANCIAL_API_BASE_URL=https://your-financial-api.example.com
BUILDINGOS_FINANCIAL_API_KEY=your-financial-api-key

# RAG (optional)
# RAG_DB_URL=postgresql://user:pass@host/db
# RAG_EMBEDDING_MODEL=bge-m3
